# ─────────────────────────────────────────────────────────────
# OLTANI Backend — Environment Variables
# Copy to .env and fill values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://oltani.pages.dev

# Firebase Admin — Service Account JSON (paste full contents on one line)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"wazup-5f7a6",...}

# Gemini — initial API keys (comma-separated). Can be edited live via Admin panel.
GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10
GEMINI_MODEL=gemini-1.5-flash

# Super Admin (created at first boot if matched)
SUPER_ADMIN_EMAIL=khalidkhattab8687@gmail.com
